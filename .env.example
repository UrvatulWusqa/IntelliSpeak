# Copy this file to .env (in the repo root) and fill in your own values.
# Never commit .env. Both the frontend (Vite) and the backend (FastAPI) read it.

# --- Supabase (Project Settings > API) ---
SUPABASE_URL=https://your-project-ref.supabase.co
# Public anon key: safe to ship to the browser, protected by RLS.
SUPABASE_ANON_KEY=your-anon-key
# Service role key: SERVER ONLY. Bypasses RLS. Never expose it to the frontend.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# Legacy JWT secret (Project Settings > API > JWT Settings).
# Only needed if your project still signs tokens with HS256. Projects using the
# newer asymmetric signing keys can leave this empty; the backend uses JWKS.
SUPABASE_JWT_SECRET=

# --- Frontend (Vite only exposes variables prefixed with VITE_) ---
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
VITE_API_BASE_URL=http://localhost:8000

# --- Google Gemini (https://aistudio.google.com/app/apikey) ---
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-2.5-flash

# --- Cloudinary (Dashboard > API Keys) ---
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-cloudinary-api-key
CLOUDINARY_API_SECRET=your-cloudinary-api-secret

# --- Backend ---
# Comma-separated list of origins allowed to call the API.
CORS_ORIGINS=http://localhost:5173
ENVIRONMENT=development
